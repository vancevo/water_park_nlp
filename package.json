{
  "name": "damsen-smart-guide",
  "version": "0.0.0",
  "private": true,
  "description": "Dam Sen multilingual guide and navigation monorepo",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.5 <12"
  },
  "packageManager": "npm@11.5.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @damsen/shared-types && npm run build --workspace @damsen/config && npm run build --workspace @damsen/api-client && npm run build --workspace @damsen/worker && npm run build --workspace @damsen/api && npm run build --workspace @damsen/admin-web && npm run build --workspace @damsen/visitor-web && npm run build --workspace @damsen/payment-web",
    "dev:api": "npm run dev --workspace @damsen/api",
    "dev:visitor": "npm run dev --workspace @damsen/visitor-web",
    "dev:payment": "npm run dev --workspace @damsen/payment-web",
    "dev:worker": "npm run dev --workspace @damsen/worker",
    "db:migrate": "node scripts/migrate.mjs",
    "seed:park": "node scripts/seed-park.mjs",
    "search:catalog:validate": "node data/search-catalog/validate.mjs",
    "search:catalog:import": "node scripts/import-search-catalog.mjs",
    "search:evaluate:real": "node scripts/evaluate-real-search.mjs",
    "data:research:generate": "python3 data/research-damsen/generate.py",
    "data:research:validate": "python3 data/research-damsen/validate.py",
    "smoke:media": "node scripts/smoke-media.mjs",
    "load:api": "node scripts/load-test.mjs",
    "storage:audit": "node scripts/storage-restore-drill.mjs audit",
    "storage:backup": "node scripts/storage-restore-drill.mjs backup",
    "storage:restore": "node scripts/storage-restore-drill.mjs restore",
    "storage:drill": "node scripts/storage-restore-drill.mjs drill",
    "operations:check": "node scripts/check-operations-consistency.mjs",
    "operations:health": "node scripts/check-operations-health.mjs",
    "operations:benchmark:dashboard": "node scripts/benchmark-operations-dashboard.mjs",
    "operations:load:realtime": "node scripts/load-operations-realtime.mjs",
    "operations:acceptance:local": "node scripts/run-operations-local-acceptance.mjs",
    "operations:demo:reset": "node scripts/reset-operations-local-demo.mjs",
    "operations:gate:staging": "node scripts/run-operations-staging-gate.mjs",
    "operations:gate:verify": "node scripts/verify-operations-staging-report.mjs",
    "operations:db:backup": "node scripts/operations-db-backup.mjs backup",
    "operations:db:restore": "node scripts/operations-db-backup.mjs restore",
    "operations:db:drill": "node scripts/operations-db-backup.mjs drill",
    "operations:drill:db-restart": "node scripts/drill-payment-db-restart.mjs",
    "operations:drill:api-restart": "node scripts/drill-payment-api-restart.mjs",
    "operations:relay": "npm run operations:relay --workspace @damsen/worker",
    "operations:smoke:relay": "node scripts/smoke-operations-outbox-worker.mjs",
    "tts:setup-voices": "node scripts/setup-piper-voices.mjs",
    "tts:benchmark-providers": "npm run benchmark:providers --workspace @damsen/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present && npm run test:operations:gate",
    "test:operations:gate": "node --test scripts/test/run-operations-staging-gate.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@types/node": "^24.0.0",
    "eslint": "9.13.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0",
    "vitest": "2.1.4"
  }
}
