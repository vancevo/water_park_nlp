{
  "name": "@damsen/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "npm run build --workspace @damsen/config",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "pretest": "npm run build --workspace @damsen/config",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@damsen/config": "0.0.0",
    "@damsen/shared-types": "0.0.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "tsx": "4.19.2"
  }
}
