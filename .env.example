NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://damsen:damsen_local_only@127.0.0.1:64321/damsen
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ENABLED=true
S3_REGION=us-east-1
S3_BUCKET=damsen-media
S3_ACCESS_KEY=damsen_local
S3_SECRET_KEY=damsen_local_password
# Optional: override the narration-locale catalog file.
# Defaults to config/narration-locales.json (resolved from the process cwd).
NARRATION_LOCALES_CONFIG_PATH=config/narration-locales.json
ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-characters
DEV_SEED_ADMIN=true
DEV_ADMIN_EMAIL=admin@damsen.local
DEV_ADMIN_PASSWORD=replace-with-a-local-admin-password
# Hybrid semantic search (AI07). OFF by default — search stays lexical. Rollback
# is flipping SEARCH_HYBRID_ENABLED back to false (no redeploy of logic).
SEARCH_HYBRID_ENABLED=false
SEARCH_HYBRID_POOL_SIZE=50
SEARCH_HYBRID_RRF_K=60
SEARCH_HYBRID_LEX_WEIGHT=1
SEARCH_HYBRID_VEC_WEIGHT=1
# Query embedding service (out-of-process; MUST match the model/version used to
# build config document embeddings). Unset = semantic path disabled.
SEARCH_EMBEDDING_URL=
SEARCH_EMBEDDING_MODEL=
SEARCH_EMBEDDING_MODEL_VERSION=
SEARCH_EMBEDDING_TIMEOUT_MS=2000
