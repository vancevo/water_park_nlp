NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://damsen:damsen_local_only@127.0.0.1:64321/damsen
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ENABLED=true
S3_REGION=us-east-1
S3_BUCKET=damsen-media
S3_ACCESS_KEY=damsen_local
S3_SECRET_KEY=damsen_local_password
# Optional: override the narration-locale catalog file.
# Defaults to config/narration-locales.json (resolved from the process cwd).
NARRATION_LOCALES_CONFIG_PATH=config/narration-locales.json
ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-characters
DEV_SEED_ADMIN=true
DEV_ADMIN_EMAIL=admin@damsen.local
DEV_ADMIN_PASSWORD=replace-with-a-local-admin-password
# Hybrid semantic search (AI07). OFF by default — search stays lexical. Rollback
# is flipping SEARCH_HYBRID_ENABLED back to false (no redeploy of logic).
SEARCH_HYBRID_ENABLED=false
SEARCH_HYBRID_POOL_SIZE=50
SEARCH_HYBRID_RRF_K=60
SEARCH_HYBRID_LEX_WEIGHT=1
SEARCH_HYBRID_VEC_WEIGHT=1
# Query embedding service (out-of-process; MUST match the model/version used to
# build config document embeddings). Unset = semantic path disabled.
SEARCH_EMBEDDING_URL=
SEARCH_EMBEDDING_MODEL=
SEARCH_EMBEDDING_MODEL_VERSION=
SEARCH_EMBEDDING_TIMEOUT_MS=2000
# --- AI TTS generation (AI04 API + I02 worker queue consumer, ADR 0010/0014) ---
# Preferred: point API and worker at the SAME voice manifest so both stamp/serve
# the same provider/model/modelVersion per locale (the idempotency key includes
# modelVersion). Piper format {binaryPath, voices[]} or CLI format {entries[]}.
# TTS_VOICES_MANIFEST_PATH=config/tts-voices.json
# Fallback when no manifest: one provider/model/version for every locale. Must
# match a worker voice or jobs fail with TTS_MODEL_UNAVAILABLE.
TTS_DEFAULT_PROVIDER=piper
TTS_DEFAULT_MODEL=vi_VN-vais1000-medium
TTS_DEFAULT_MODEL_VERSION=piper-voices-v1.0.0
TTS_JOB_MAX_ATTEMPTS=3
# AI08 kill switch (API create → 503 AI_FEATURE_DISABLED; worker stops claiming).
TTS_GENERATION_ENABLED=true
# AI08 quota: TTS_QUOTA_WINDOW_MS/TTS_QUOTA_MAX_PER_WINDOW are read by BOTH
# processes: per user per API process for create (429 rate_limited) and per
# worker process for claims. Backlog cap on queued+running rows (API, 429
# concurrency_limited). TTS_QUOTA_MAX_CONCURRENT = jobs run at once per worker.
TTS_QUOTA_WINDOW_MS=60000
TTS_QUOTA_MAX_PER_WINDOW=120
TTS_QUEUE_MAX_ACTIVE=50
TTS_QUOTA_MAX_CONCURRENT=4
# Worker: engine "piper" (Piper manifest) or "cli" (CLI provider manifest).
TTS_WORKER_ENGINE=piper
TTS_WORKER_POLL_MS=1000
TTS_JOB_TIMEOUT_MS=120000
TTS_JOB_BACKOFF_MS=500
# Must exceed TTS_JOB_TIMEOUT_MS + 180000 (3 storage calls) + the longest backoff; the worker refuses to start otherwise.
TTS_JOB_STALE_RUNNING_MS=1800000
# rights_owner stamped on generated draft audio (quote it when sourcing):
# TTS_AUDIO_RIGHTS_OWNER="Dam Sen Smart Guide project (AI-generated draft)"
# C04 release encoding: wav (default, unchanged) | mp3 | m4a. The validated WAV
# is encoded with ffmpeg inside the same per-attempt timeout; needs ffmpeg on
# the worker host (TTS_FFMPEG_PATH). Speech is mono; 64k is plenty.
TTS_AUDIO_RELEASE_FORMAT=wav
TTS_AUDIO_BITRATE=64k
# TTS_FFMPEG_PATH=ffmpeg
# C07 worker Prometheus endpoint: GET /metrics and /healthz. Loopback by
# default; use 0.0.0.0 only on a private network the scraper reaches (no auth).
WORKER_METRICS_ENABLED=true
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=9464
# Storage backup/restore (scripts/storage-restore-drill.mjs): backup bucket.
# BACKUP_S3_BUCKET=damsen-media-backup
